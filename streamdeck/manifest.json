{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Icon": "assets/actions/status",
      "Name": "Hear Status",
      "States": [
        {
          "Image": "assets/states/status",
          "Title": "Status",
          "TitleAlignment": "middle",
          "TitleColor": "#00E7F9"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Privately speak SafeSpeak's connection, safety, queue, and playback status",
      "UUID": "com.safespeak.streamdeck.status"
    },
    {
      "Icon": "assets/actions/arm",
      "Name": "Arm / Disarm",
      "States": [
        {
          "Image": "assets/states/disarmed",
          "Title": "Disarmed",
          "TitleAlignment": "middle",
          "TitleColor": "#888888"
        },
        {
          "Image": "assets/states/armed",
          "Title": "Armed",
          "TitleAlignment": "middle",
          "TitleColor": "#00FF66"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Arm or disarm SafeSpeak monitoring and text to speech",
      "UUID": "com.safespeak.streamdeck.arm"
    },
    {
      "Icon": "assets/actions/panic",
      "Name": "Emergency Stop",
      "States": [
        {
          "Image": "assets/states/panic",
          "Title": "STOP",
          "TitleAlignment": "middle",
          "TitleColor": "#FF3333"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Stop audio, clear the queue, and disarm SafeSpeak",
      "UUID": "com.safespeak.streamdeck.panic"
    },
    {
      "Icon": "assets/actions/autoplay",
      "Name": "Playback Mode",
      "States": [
        {
          "Image": "assets/states/manual",
          "Title": "Manual",
          "TitleAlignment": "middle",
          "TitleColor": "#FFAA00"
        },
        {
          "Image": "assets/states/auto",
          "Title": "Automatic",
          "TitleAlignment": "middle",
          "TitleColor": "#00E7F9"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Switch between automatic speech and manual Speak Next mode",
      "UUID": "com.safespeak.streamdeck.autoplay"
    },
    {
      "Icon": "assets/actions/pause",
      "Name": "Pause / Resume TTS",
      "States": [
        {
          "Image": "assets/states/play",
          "Title": "Playing",
          "TitleAlignment": "middle",
          "TitleColor": "#00FF66"
        },
        {
          "Image": "assets/states/pause",
          "Title": "Paused",
          "TitleAlignment": "middle",
          "TitleColor": "#FFAA00"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Pause or resume automatic text-to-speech playback",
      "UUID": "com.safespeak.streamdeck.pause"
    },
    {
      "Icon": "assets/actions/next",
      "Name": "Speak Next",
      "States": [
        {
          "Image": "assets/states/next",
          "Title": "Speak Next",
          "TitleAlignment": "middle",
          "TitleColor": "#00FF66"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Speak one approved message while SafeSpeak is in manual mode",
      "UUID": "com.safespeak.streamdeck.next"
    },
    {
      "Icon": "assets/actions/skip",
      "Name": "Stop Current",
      "States": [
        {
          "Image": "assets/states/skip",
          "Title": "Stop Current",
          "TitleAlignment": "middle",
          "TitleColor": "#FFFFFF"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Stop the message that is currently being spoken",
      "UUID": "com.safespeak.streamdeck.skip"
    },
    {
      "Icon": "assets/actions/clear",
      "Name": "Clear Queue",
      "States": [
        {
          "Image": "assets/states/clear",
          "Title": "Clear Queue",
          "TitleAlignment": "middle",
          "TitleColor": "#FFAA00"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Remove all pending text-to-speech messages",
      "UUID": "com.safespeak.streamdeck.clear"
    }
  ],
  "Author": "SafeSpeak",
  "Category": "SafeSpeak",
  "CategoryIcon": "assets/category",
  "CodePath": "app.html",
  "Description": "Essential SafeSpeak monitoring and TTS controls for livestreamers.",
  "Icon": "assets/plugin",
  "Name": "SafeSpeak",
  "UUID": "com.safespeak.streamdeck",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "Version": "1.1.0.0",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ]
}
