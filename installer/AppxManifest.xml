<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 rescap">

  <Identity Name="SafeSpeak.App"
            Publisher="CN=SafeSpeak"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SafeSpeak</DisplayName>
    <PublisherDisplayName>SafeSpeak</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Intelligent Accessible TTS Moderation Agent for Livestreamers</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="SafeSpeak"
                 Executable="SafeSpeak.App.exe"
                 uap10:RuntimeBehavior="packagedClassicApp"
                 uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="SafeSpeak"
                          Description="Intelligent Accessible TTS Moderation Agent"
                          BackgroundColor="#121214"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="SafeSpeak" Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required by the packaged WPF desktop process that uses local WebSocket/IPC and Windows audio APIs. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
