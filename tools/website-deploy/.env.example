# SafeSpeak website FTPS deployment
#
# Create a dedicated, jailed server account for SafeSpeak. Do not reuse the
# credentials from another website project.
FTP_HOST=test.pki.bl4ut0.dev
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/domains/safespeak.bl4ut0.dev/public_html
FTP_SECURE=true
FTP_REJECT_UNAUTHORIZED=true
FTP_CA_FILE=server-ca.pem

# Used only to verify the public pages after upload. DNS and HTTPS must exist
# before verification can pass.
PUBLIC_BASE_URL=https://safespeak.bl4ut0.dev
