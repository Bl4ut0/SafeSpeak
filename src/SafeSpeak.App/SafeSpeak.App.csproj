<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SafeSpeak.Core\SafeSpeak.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="KokoroSharp" Version="0.8.4" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- KokoroSharp's upstream target copies voice embeddings after Build but not after Publish.
       Declare the English embeddings explicitly so portable and MSIX releases are complete. -->
  <ItemGroup>
    <Content Include="$(PkgKokoroSharp)\content\voices\af_*.npy;$(PkgKokoroSharp)\content\voices\am_*.npy;$(PkgKokoroSharp)\content\voices\bf_*.npy;$(PkgKokoroSharp)\content\voices\bm_*.npy">
      <Link>voices\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SafeSpeak.App</AssemblyName>
    <RootNamespace>SafeSpeak.App</RootNamespace>
    <AssemblyTitle>SafeSpeak</AssemblyTitle>
    <Product>SafeSpeak</Product>
    <Description>Accessible TTS moderation and playback for livestreamers.</Description>
    <Company>SafeSpeak</Company>
    <Authors>Alex Mammen</Authors>
    <Copyright>Copyright (c) 2026 Alex Mammen. All rights reserved.</Copyright>
    <RepositoryUrl>https://github.com/Bl4ut0/SafeSpeak</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en-US</NeutralLanguage>
    <ApplicationIcon>..\..\installer\Assets\SafeSpeak.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
