<Window x:Class="SafeSpeak.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SafeSpeak.App.ViewModels"
        xmlns:c="clr-namespace:SafeSpeak.App.Converters"
        xmlns:a11y="clr-namespace:SafeSpeak.App.Accessibility"
        Title="SafeSpeak — Accessible TTS Safety"
        Height="700" Width="720"
        MinHeight="620" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="SafeSpeak main window">
    <Window.DataContext><vm:MainViewModel /></Window.DataContext>
    <Window.Resources>
        <c:ArmedToTextConverter x:Key="ArmedToTextConverter" />
        <c:SpeakingToTextConverter x:Key="SpeakingToTextConverter" />
        <c:InverseBoolConverter x:Key="InverseBoolConverter" />
        <c:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <c:DispositionToBackgroundBrushConverter x:Key="DispositionToBackgroundBrushConverter" />
        <c:DispositionToForegroundBrushConverter x:Key="DispositionToForegroundBrushConverter" />

        <Style x:Key="FeedItem" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource SafeSpeakWindowBrush}"
          TextElement.Foreground="{DynamicResource SafeSpeakTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Persistent first action plus main tab navigation hub. -->
        <Grid Grid.Row="0" Margin="10,10,10,8"
              KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="HearStatusButton"
                    Grid.Column="0" TabIndex="1" Panel.ZIndex="1"
                    Margin="0,0,3,0" VerticalAlignment="Top"
                    Style="{StaticResource NavigationActionButton}"
                    Command="{Binding AnnounceStatusPrivatelyCommand}"
                    Content="Hear status"
                    AutomationProperties.Name="Hear current SafeSpeak status"
                    AutomationProperties.HelpText="{Binding HearStatusHelpText}" />

            <TabControl x:Name="MainNavigation"
                    Grid.ColumnSpan="2" TabIndex="2"
                    KeyboardNavigation.TabNavigation="Local"
                    AutomationProperties.Name="SafeSpeak main navigation tabs. Use Left and Right Arrow keys, or Control plus 1 through 4, to switch between Live, Safety, Voice, and Settings tabs."
                    AutomationProperties.HelpText="Use Left and Right Arrow keys to select a tab, then press Tab to move into that tab's controls. The only fixed SafeSpeak shortcuts are Control plus 1, 2, 3, and 4 for opening the four pages. Action shortcuts are customizable in Settings.">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="Transparent" />
                            <UniformGrid Grid.Column="1" Rows="1" IsItemsHost="True" />
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{DynamicResource SafeSpeakWindowBrush}"
                                BorderBrush="{DynamicResource SafeSpeakBorderBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- Tab 1: Live Feed -->
            <TabItem Header="Live" AutomationProperties.Name="Live tab, one of four">
                <Grid Margin="10,10,10,8" MaxWidth="900"
                      KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="SafeSpeak" Style="{StaticResource PageTitle}"
                                   FontSize="{DynamicResource SafeSpeakFont24}"
                                   VerticalAlignment="Center" />
                        <UniformGrid Columns="4" Margin="0,6,0,0">
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="SOURCE" Style="{StaticResource StatusLabel}" />
                                    <TextBlock Text="{Binding ConnectionStatusText}" Style="{StaticResource StatusValue}"
                                               AutomationProperties.Name="{Binding ConnectionStatusText}"
                                               AutomationProperties.LiveSetting="Polite"
                                               a11y:LiveRegion.Announcement="{Binding ConnectionStatusText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="TTS SAFETY" Style="{StaticResource StatusLabel}" />
                                    <TextBlock Text="{Binding ArmedStatusText}" Style="{StaticResource StatusValue}"
                                               AutomationProperties.Name="{Binding ArmedStatusText, StringFormat=Text to speech {0}}"
                                               AutomationProperties.LiveSetting="Polite"
                                               a11y:LiveRegion.Announcement="{Binding ArmedStatusText, StringFormat=Text to speech {0}}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="QUEUE" Style="{StaticResource StatusLabel}" />
                                    <TextBlock Text="{Binding QueueCount, StringFormat={}{0} messages}" Style="{StaticResource StatusValue}"
                                               AutomationProperties.Name="{Binding QueueCount, StringFormat=Queue has {0} messages}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusCard}">
                                <StackPanel>
                                    <TextBlock Text="PLAYBACK" Style="{StaticResource StatusLabel}" />
                                    <TextBlock Text="{Binding PlaybackModeStatus}" Style="{StaticResource StatusValue}"
                                               AutomationProperties.Name="{Binding PlaybackModeStatus, StringFormat=Playback mode {0}}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CommandSurface}" Margin="0,0,0,8">
                        <StackPanel>
                            <ToggleButton x:Name="ArmToggle" TabIndex="1"
                                          MinHeight="48"
                                          Margin="0,0,0,6"
                                          Style="{StaticResource ArmToggleButton}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          FontSize="{DynamicResource SafeSpeakFont17}"
                                          IsChecked="{Binding IsArmed, Mode=OneWay}"
                                          Command="{Binding ToggleArmCommand}"
                                          Content="{Binding IsArmed, Converter={StaticResource ArmedToTextConverter}}"
                                          AutomationProperties.Name="{Binding ArmedStatusText, StringFormat=Arm toggle button: currently {0}}"
                                          AutomationProperties.HelpText="{Binding ArmToggleHelpText}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button x:Name="EmergencyStopButton"
                                        Grid.Row="0" Grid.Column="0" TabIndex="2" Margin="0,0,6,6"
                                        Style="{StaticResource EmergencyButton}"
                                        Visibility="{Binding IsArmed, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsVisibleChanged="EmergencyStopButton_IsVisibleChanged"
                                        Command="{Binding EmergencyStopCommand}" Content="Emergency stop"
                                        AutomationProperties.Name="Emergency stop"
                                        AutomationProperties.HelpText="{Binding EmergencyStopHelpText}" />

                                <Button x:Name="PauseOrResumeButton"
                                        Grid.Row="0" Grid.Column="1" TabIndex="3" Margin="0,0,6,6"
                                        Style="{StaticResource CommandButton}"
                                        Visibility="{Binding ShowAutomaticOrPausedControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding PauseOrResumeTtsCommand}"
                                        Content="{Binding PauseButtonText}"
                                        AutomationProperties.Name="{Binding PauseButtonAutomationName}"
                                        AutomationProperties.HelpText="Pause lets the current message finish. Resume returns to automatic playback." />

                                <Button x:Name="UseAutomaticPlaybackButton"
                                        Grid.Row="0" Grid.Column="1" TabIndex="4" Margin="0,0,6,6"
                                        Style="{StaticResource CommandButton}"
                                        Visibility="{Binding ShowManualControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="PlaybackModeButton_Click"
                                        Command="{Binding UseAutomaticPlaybackCommand}" Content="Automatic mode"
                                        AutomationProperties.Name="Use automatic playback mode button"
                                        AutomationProperties.HelpText="Approved messages speak automatically while SafeSpeak is armed." />

                                <Button x:Name="UseManualPlaybackButton"
                                        Grid.Row="0" Grid.Column="2" TabIndex="5" Margin="0,0,0,6"
                                        Style="{StaticResource CommandButton}"
                                        Visibility="{Binding ShowAutomaticOrPausedControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="PlaybackModeButton_Click"
                                        Command="{Binding UseManualPlaybackCommand}" Content="Manual mode"
                                        AutomationProperties.Name="Use manual playback mode button"
                                        AutomationProperties.HelpText="Approved messages wait until Speak next approved message is chosen." />

                                <Button x:Name="SpeakNextApprovedMessageButton"
                                        Grid.Row="0" Grid.Column="2" TabIndex="6" Margin="0,0,0,6"
                                        Style="{StaticResource CommandButton}"
                                        Visibility="{Binding ShowManualControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding SpeakNextApprovedMessageCommand}" Content="Speak next"
                                        AutomationProperties.Name="Speak next approved message button"
                                        AutomationProperties.HelpText="In manual mode, speaks exactly one approved queued message." />

                                <Button Grid.Row="1" Grid.Column="0" TabIndex="7" Margin="0,0,6,0"
                                        Style="{StaticResource CommandButton}"
                                        Visibility="{Binding IsArmed, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding StopCurrentSpeechCommand}" Content="Stop current"
                                        AutomationProperties.Name="{Binding StopCurrentSpeechAutomationName}"
                                        AutomationProperties.HelpText="Immediately stops only the message currently speaking." />

                                <Button Grid.Row="1" Grid.Column="1" TabIndex="8" Margin="0,0,6,0"
                                        Style="{StaticResource CommandButton}"
                                        Visibility="{Binding IsArmed, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding ClearQueueCommand}" Content="Clear queue"
                                        AutomationProperties.Name="Clear pending text to speech queue button"
                                        AutomationProperties.HelpText="Removes pending approved messages without stopping the current message or disarming SafeSpeak." />

                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource StatusCard}" Margin="0,0,0,8" Padding="10">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Live Stream Source" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SourceDescription}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" TabIndex="9" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Style="{StaticResource CompactButton}"
                                     Command="{Binding RetrySourceConnectionCommand}" Content="Reconnect"
                                     AutomationProperties.Name="Reconnect to live stream source button" />
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,0,0,5" LastChildFill="True">
                        <Button DockPanel.Dock="Right" TabIndex="10" Margin="10,0,0,0"
                                Style="{StaticResource CompactButton}"
                                Command="{Binding AnnounceLiveFeedReviewStatusCommand}"
                                Content="Hear review status"
                                AutomationProperties.Name="Hear live activity review status button"
                                AutomationProperties.HelpText="Reports whether visual feed updates are paused and how many received messages are retained for review." />
                        <TextBlock Text="Live activity" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ListView x:Name="LiveFeedListView"
                              Grid.Row="4" TabIndex="11" ItemsSource="{Binding LiveFeed}"
                              ItemContainerStyle="{StaticResource FeedItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              GotKeyboardFocus="LiveFeedListView_GotKeyboardFocus"
                              LostKeyboardFocus="LiveFeedListView_LostKeyboardFocus"
                              AutomationProperties.Name="Live moderation activity list. Shows incoming messages, safety dispositions, and moderation reasons. Visual updates pause automatically while keyboard focus is inside this list."
                              AutomationProperties.ItemStatus="{Binding LiveFeedReviewStatus}"
                              AutomationProperties.HelpText="Use Arrow keys to review entries. New visual entries are held while this list has keyboard focus; moderation and text to speech continue. Leave the list to show held entries and resume visual updates.">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusCard}" Padding="14" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- Header line: Status badge + Author -->
                                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                                            <Border CornerRadius="4" Padding="8,2" Margin="0,0,10,0"
                                                    Background="{Binding Disposition, Converter={StaticResource DispositionToBackgroundBrushConverter}}">
                                                <TextBlock Text="{Binding Disposition}" FontWeight="Bold" FontSize="{DynamicResource SafeSpeakFont13}"
                                                           Foreground="{Binding Disposition, Converter={StaticResource DispositionToForegroundBrushConverter}}" />
                                            </Border>
                                            <TextBlock Text="{Binding SafeAuthorDisplayName}" FontWeight="SemiBold" FontSize="{DynamicResource SafeSpeakFont15}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Message content -->
                                        <TextBlock Grid.Row="1" Text="{Binding SafeDisplayText}" FontSize="{DynamicResource SafeSpeakFont15}" TextWrapping="Wrap" Margin="0,0,0,4" />

                                        <!-- Moderation reason note -->
                                        <TextBlock Grid.Row="2" Text="{Binding SafeReasonDescription}"
                                                   Style="{StaticResource SecondaryText}" FontSize="{DynamicResource SafeSpeakFont13}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Tab 2: Safety -->
            <TabItem Header="Safety" AutomationProperties.Name="Safety tab, two of four">
                <ScrollViewer x:Name="SafetyPageScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,12,14,10" MaxWidth="760"
                                KeyboardNavigation.TabNavigation="Local">
                        <TextBlock Text="Safety" Style="{StaticResource PageTitle}" FontSize="{DynamicResource SafeSpeakFont26}" />

                        <Border x:Name="SafetyGuideControlsTop" Style="{StaticResource ContentPanel}" Margin="0,7,0,10"
                                Visibility="{Binding AreSafetyGuideControlsAtTop, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Safety guide" FontWeight="SemiBold"
                                           FontSize="{DynamicResource SafeSpeakFont17}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel>
                                        <Button x:Name="ReadModerationGuideButton" TabIndex="1" Margin="0,0,7,5"
                                                Command="{Binding ReadModerationGuideCommand}"
                                                Content="Play whole guide"
                                                AutomationProperties.Name="Play the whole Safety guide button"
                                                AutomationProperties.HelpText="Reads every Safety guide page through SafeSpeak built-in guidance. Use the configured Shut up built-in guidance shortcut to stop playback." />
                                        <Button x:Name="ReadModerationGuidePageButton" TabIndex="2" Margin="0,0,7,5"
                                                Command="{Binding ReadNextModerationGuideSectionCommand}"
                                                Content="Play guide page"
                                                AutomationProperties.Name="Play the next Safety guide page button"
                                                AutomationProperties.HelpText="Reads one Safety guide page and advances to the next page, wrapping to page 1 after the final page." />
                                        <Button x:Name="ResetModerationGuideButton" TabIndex="3" Margin="0,0,7,5"
                                                Command="{Binding RestartModerationGuideCommand}"
                                                Content="Reset guide"
                                                AutomationProperties.Name="Reset the Safety guide to page 1 button"
                                                AutomationProperties.HelpText="Returns the Safety guide to page 1 without starting playback." />
                                    </WrapPanel>
                                    <Button x:Name="ToggleSafetyGuideButton" Grid.Column="1" TabIndex="4" Margin="7,0,0,5"
                                            Command="{Binding ToggleSafetyGuideVisibilityCommand}"
                                            Click="GuidePlacementButton_Click"
                                            Content="{Binding SafetyGuideVisibilityButtonText}"
                                            AutomationProperties.Name="{Binding SafetyGuideVisibilityButtonAutomationName}"
                                            AutomationProperties.HelpText="Moves all four Safety guide controls, including this button, to the bottom of the page. Navigate to the bottom of the Safety page to find this button again, labeled Move controls to top. The guide text remains visible." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Label x:Name="SafetyModerationChapterHeading" TabIndex="5" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 1 — Moderation strength and model"
                               AutomationProperties.Name="Safety chapter 1 of 4, moderation strength and model"
                               AutomationProperties.HelpText="The following controls choose the moderation level and contextual filtering model." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Target="{Binding ElementName=ModerationSlider}"
                                   Content="Moderation strength" Padding="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding ModerationStrengthSummary}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       AutomationProperties.Name="{Binding ModerationLevelAccessibleText}"
                                       AutomationProperties.LiveSetting="Polite"
                                       a11y:LiveRegion.Announcement="{Binding ModerationLevelAccessibleText}" />
                        </Grid>
                        <Slider x:Name="ModerationSlider" TabIndex="6" Minimum="1" Maximum="4"
                                Value="{Binding ModerationLevel, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="{Binding ModerationLevelAccessibleText}"
                                AutomationProperties.HelpText="Use Left and Right Arrow keys to adjust moderation strictness from Relaxed to Maximum." />
                        <Label Target="{Binding ElementName=ModerationModelSelector}"
                               Content="Contextual filtering model" Padding="0" Margin="0,8,0,4"
                               FontWeight="SemiBold" />
                        <ComboBox x:Name="ModerationModelSelector" TabIndex="7"
                                  ItemsSource="{Binding ModerationModelChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedModerationModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  PreviewKeyDown="SelectionComboBox_PreviewKeyDown"
                                  AutomationProperties.Name="Contextual filtering model selector"
                                  AutomationProperties.ItemStatus="{Binding ModerationModelSelectionAccessibleText}"
                                  AutomationProperties.HelpText="Press Enter, Space, Alt plus Down Arrow, or F4 to open the choices. Then use Arrow keys and Enter to select. The optional compressed Qwen3Guard model uses about 484 megabytes. SafeSpeak installs and runs it privately; no other application or terminal command is required. The built-in model stays active if it is unavailable.">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                    <Setter Property="AutomationProperties.PositionInSet" Value="{Binding Position}" />
                                    <Setter Property="AutomationProperties.SizeOfSet" Value="2" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Text="{Binding IntentModelStatus}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   AutomationProperties.Name="{Binding IntentModelStatus}" />
                        <Border Style="{StaticResource ContentPanel}" Margin="0,8,0,0" Padding="12"
                                Visibility="{Binding IsQwenModelSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Optional local model" FontWeight="SemiBold"
                                           AutomationProperties.Name="Optional Qwen3Guard local model controls" />
                                <TextBlock Text="{Binding QwenModelStorageSummary}"
                                           Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,3,0,8" />
                                <WrapPanel>
                                    <Button x:Name="InstallQwenModelButton" TabIndex="8" Margin="0,0,7,5"
                                            Command="{Binding InstallQwenModelCommand}"
                                            IsEnabled="{Binding CanInstallQwenModel}"
                                            Content="Install optional model"
                                            AutomationProperties.Name="Install optional Qwen3Guard model button"
                                            AutomationProperties.HelpText="Downloads, verifies, and activates the model inside SafeSpeak. No separate Ollama installation or terminal command is needed." />
                                    <Button x:Name="CancelQwenModelInstallButton" TabIndex="9" Margin="0,0,7,5"
                                            Command="{Binding CancelQwenModelInstallCommand}"
                                            IsEnabled="{Binding CanCancelQwenModelInstall}"
                                            Content="Cancel model download"
                                            AutomationProperties.Name="Cancel optional model download button" />
                                    <Button x:Name="RemoveQwenModelButton" TabIndex="10" Margin="0,0,0,5"
                                            Command="{Binding RemoveQwenModelCommand}"
                                            IsEnabled="{Binding CanRemoveQwenModel}"
                                            Content="Remove optional model"
                                            AutomationProperties.Name="Remove optional Qwen3Guard model button"
                                            AutomationProperties.HelpText="Removes the optional model from SafeSpeak local data and returns contextual filtering to the built-in enhanced model." />
                                </WrapPanel>
                                <ProgressBar Height="8" Minimum="0" Maximum="100"
                                             Value="{Binding ModerationModelDownloadProgress}"
                                             Visibility="{Binding IsInstallingModerationModel, Converter={StaticResource BoolToVisibilityConverter}}"
                                             AutomationProperties.Name="Optional model download progress"
                                             AutomationProperties.ItemStatus="{Binding ModerationModelDownloadStatus}" />
                                <TextBlock Text="{Binding ModerationModelDownloadStatus}"
                                           Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           AutomationProperties.Name="{Binding ModerationModelDownloadStatus}"
                                           AutomationProperties.LiveSetting="Polite"
                                           a11y:LiveRegion.Announcement="{Binding ModerationModelAccessibleProgress}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ContentPanel}" Padding="0" Margin="0,8,0,10">
                            <StackPanel>
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Filtering model" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding IntentModelShortStatus}"
                                               TextAlignment="Right" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SafeSpeakSuccessBrush}"
                                               AutomationProperties.Name="{Binding IntentModelStatus}" />
                                </Grid>
                                <Border BorderBrush="{DynamicResource SafeSpeakBorderBrush}" BorderThickness="0,1,0,0" />
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Banned words" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding BannedRulesSummary}"
                                               TextAlignment="Right" Style="{StaticResource SecondaryText}" />
                                </Grid>
                                <Border BorderBrush="{DynamicResource SafeSpeakBorderBrush}" BorderThickness="0,1,0,0" />
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Evasion rules" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding EvasionRulesSummary}"
                                               TextAlignment="Right" Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Label TabIndex="11" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 2 — Custom word filtering"
                               AutomationProperties.Name="Safety chapter 2 of 4, custom word filtering"
                               AutomationProperties.HelpText="The following controls manage custom banned and allowed words and phrases." />
                        <TextBlock Text="Banned words and phrases" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" TabIndex="13" Margin="8,0,0,0"
                                    Command="{Binding AddCustomBlockedTermCommand}" Content="Add"
                                    AutomationProperties.Name="Add banned term button" />
                            <TextBox x:Name="BannedTermInput" TabIndex="12"
                                     Text="{Binding CustomBlockedInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New banned word or phrase input box. Type a term and press Enter or Add.">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCustomBlockedTermCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="CustomBlockedTermsList" TabIndex="14" MinHeight="80"
                                     ItemsSource="{Binding CustomBlockedTerms}"
                                     SelectedItem="{Binding SelectedCustomBlockedTerm}"
                                     AutomationProperties.Name="Custom banned terms. Use Arrow keys to browse terms." />
                            <Button Grid.Column="1" TabIndex="15" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding RemoveSelectedCustomBlockedTermCommand}"
                                    Content="Remove"
                                    AutomationProperties.Name="Remove selected banned term button" />
                        </Grid>

                        <TextBlock Text="Allowed words and phrases" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="An allowed entry overrides only the same custom banned entry. Built-in severe-abuse rules, script protection, and contextual moderation always remain active."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" TabIndex="17" Margin="8,0,0,0"
                                    Command="{Binding AddCustomAllowedTermCommand}" Content="Add allowed"
                                    AutomationProperties.Name="Add allowed term button"
                                    AutomationProperties.HelpText="Adds this word or phrase to the custom allowed list without disabling built-in or contextual safety checks." />
                            <TextBox x:Name="AllowedTermInput" TabIndex="16"
                                     Text="{Binding CustomAllowedInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New allowed word or phrase input box. Type a term and press Enter or Add allowed.">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCustomAllowedTermCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="CustomAllowedTermsList" TabIndex="18" MinHeight="80"
                                     ItemsSource="{Binding CustomAllowedTerms}"
                                     SelectedItem="{Binding SelectedCustomAllowedTerm}"
                                     AutomationProperties.Name="Custom allowed terms. Use Arrow keys to browse terms."
                                     AutomationProperties.ItemStatus="{Binding AllowedRulesSummary}" />
                            <Button Grid.Column="1" TabIndex="19" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding RemoveSelectedCustomAllowedTermCommand}"
                                    Content="Remove"
                                    AutomationProperties.Name="Remove selected allowed term button" />
                        </Grid>

                        <Label TabIndex="20" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 3 — Test the current filter"
                               AutomationProperties.Name="Safety chapter 3 of 4, test the current filter"
                               AutomationProperties.HelpText="The following controls test one message without broadcasting, queueing, or logging it." />
                        <TextBlock Text="Test a message" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" TabIndex="22" Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding TestFilterCommand}" Content="Test filter"
                                    AutomationProperties.Name="Test current safety filter button" />
                            <TextBox x:Name="FilterTestInput" TabIndex="21"
                                     Text="{Binding FilterTestInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Message to test against the current safety settings">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding TestFilterCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <Border Margin="0,8,0,0" Padding="12,9"
                                Visibility="{Binding HasFilterTestResult, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding FilterTestResult}"
                                AutomationProperties.LiveSetting="Assertive"
                                a11y:LiveRegion.Announcement="{Binding FilterTestResult}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ContentPanel}">
                                    <Setter Property="Background" Value="{DynamicResource SafeSpeakAccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakDangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterTestPassed}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FilterTestResult}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="Test messages are not broadcast, queued, added to Live Activity, or logged."
                                   Style="{StaticResource SecondaryText}" Margin="0,7,0,0" />

                        <Label TabIndex="23" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 4 — Safety guide and examples"
                               AutomationProperties.Name="Safety chapter 4 of 4, safety guide and examples"
                               AutomationProperties.HelpText="The following reference explains the slider, contextual signals, examples, and always-on protections." />
                        <Border x:Name="ModerationGuidePanel"
                                Style="{StaticResource ContentPanel}" Margin="0,14,0,10">
                            <StackPanel>
                                <TextBlock Text="How SafeSpeak safety filtering works"
                                           FontWeight="SemiBold" FontSize="{DynamicResource SafeSpeakFont17}" />
                                <TextBlock Text="{Binding ModerationLevelDescription}"
                                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                <TextBlock Text="What the slider changes" FontWeight="SemiBold" Margin="0,9,0,0" />
                                <TextBlock Text="The slider changes only the minimum contextual-hostility score required to block a message. It does not turn the always-on safety layers off."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,6" />
                                <TextBlock Text="{Binding ModerationLevelThresholdSummary}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding ModerationLevelThresholdSummary}" />
                                <TextBlock Text="All four cutoffs" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding ModerationLevelGuide}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Contextual wording signals" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding ContextualIntentSignals}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Examples accepted at every level" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding AcceptedHostilityExamples}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Examples blocked as strictness increases" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding RejectedHostilityExamples}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="How the slider changes filtering" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding SliderDependentHostilityExamples}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Sensitive child-safety context" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding SensitiveContextExamples}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Always checked at every slider level" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding AlwaysOnModerationLayers}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Here, intent means a local model scores the wording of one message for hostile or harmful meaning. It does not see earlier chat messages or know relationships, tone of voice, sarcasm, or shared jokes. The decision answers whether the message is safe to speak; it is not a judgment of the sender's motive."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0"
                                           AutomationProperties.Name="Intent-filter limitation. SafeSpeak evaluates one message at a time and does not see conversation history, relationships, tone, sarcasm, or shared jokes." />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SafetyGuideControlsEnd" Style="{StaticResource ContentPanel}" Margin="0,0,0,4"
                                Visibility="{Binding AreSafetyGuideControlsAtEnd, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Safety guide controls, at the bottom of the page"
                                           FontWeight="SemiBold" FontSize="{DynamicResource SafeSpeakFont17}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel>
                                                <Button x:Name="ReadModerationGuideButtonAtEnd" TabIndex="24" Margin="0,0,7,5"
                                                Command="{Binding ReadModerationGuideCommand}"
                                                Content="Play whole guide"
                                                AutomationProperties.Name="Play the whole Safety guide button, at the bottom of the page"
                                                AutomationProperties.HelpText="Reads every Safety guide page through SafeSpeak built-in guidance." />
                                                <Button x:Name="ReadModerationGuidePageButtonAtEnd" TabIndex="25" Margin="0,0,7,5"
                                                Command="{Binding ReadNextModerationGuideSectionCommand}"
                                                Content="Play guide page"
                                                AutomationProperties.Name="Play the next Safety guide page button, at the bottom of the page"
                                                AutomationProperties.HelpText="Reads one Safety guide page and advances to the next page." />
                                                <Button x:Name="ResetModerationGuideButtonAtEnd" TabIndex="26" Margin="0,0,7,5"
                                                Command="{Binding RestartModerationGuideCommand}"
                                                Content="Reset guide"
                                                AutomationProperties.Name="Reset the Safety guide to page 1 button, at the bottom of the page"
                                                AutomationProperties.HelpText="Returns the Safety guide to page 1 without starting playback." />
                                    </WrapPanel>
                                            <Button x:Name="ToggleSafetyGuideButtonAtEnd" Grid.Column="1" TabIndex="27" Margin="7,0,0,5"
                                            Command="{Binding ToggleSafetyGuideVisibilityCommand}"
                                            Click="GuidePlacementButton_Click"
                                            Content="{Binding SafetyGuideVisibilityButtonText}"
                                            AutomationProperties.Name="{Binding SafetyGuideVisibilityButtonAutomationName}"
                                            AutomationProperties.HelpText="Moves all four Safety guide controls, including this button, to the top of the page. Navigate to the top of the Safety page to find this button again, labeled Move controls to bottom. The guide text remains visible." />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Voice -->
            <TabItem Header="Voice" AutomationProperties.Name="Voice tab, three of four">
                <ScrollViewer x:Name="VoicePageScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,12,14,10" MaxWidth="760"
                                KeyboardNavigation.TabNavigation="Local">
                        <TextBlock Text="Voice" Style="{StaticResource PageTitle}" FontSize="{DynamicResource SafeSpeakFont26}" />

                        <TextBlock Text="Current voice" FontWeight="SemiBold" Margin="0,9,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VoiceCombo" TabIndex="1"
                                      ItemsSource="{Binding Voices}"
                                      SelectedValuePath="Id" SelectedValue="{Binding SelectedVoice}"
                                      PreviewKeyDown="SelectionComboBox_PreviewKeyDown"
                                      AutomationProperties.Name="Active speech voice"
                                      AutomationProperties.HelpText="Press Enter, Space, Alt plus Down Arrow, or F4 to open the voice list without changing the current voice. Then use Arrow keys and Enter to select. Use Preview to hear a sample.">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem"
                                           BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   AutomationProperties.Name="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" TabIndex="2" Margin="8,0,0,0"
                                    Command="{Binding TestSelectedVoiceCommand}" Content="Preview"
                                    AutomationProperties.Name="Preview selected voice button. Plays a test phrase using the current voice settings." />
                        </Grid>

                        <Border Style="{StaticResource ContentPanel}" Margin="0,10,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=RateSlider}" Content="Speech speed" Padding="0" FontWeight="SemiBold" />
                                    <Slider x:Name="RateSlider" Grid.Column="1" TabIndex="3"
                                            Minimum="-5" Maximum="5" Margin="14,0"
                                            Value="{Binding SpeechRate}" TickFrequency="1" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="Voice speed slider from -5 slow to +5 fast"
                                            AutomationProperties.HelpText="Use Left and Right Arrow keys to adjust voice speed one step at a time." />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeechRate, StringFormat={}{0:+0;-0;0}}"
                                               VerticalAlignment="Center" MinWidth="28" TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=VolumeSlider}" Content="Volume" Padding="0" FontWeight="SemiBold" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" TabIndex="4"
                                            Minimum="0" Maximum="150" Margin="14,0"
                                            Value="{Binding SpeechVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TickFrequency="5" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="Voice volume slider from 0 to 150 percent"
                                            AutomationProperties.HelpText="Use Left and Right Arrow keys to adjust voice volume in five percent steps. 100 percent is the default; values above 100 add software amplification and may clip on louder voices." />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeechVolume, StringFormat={}{0}%}"
                                               VerticalAlignment="Center" MinWidth="38" TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=InterMessageGapSlider}"
                                           Content="Maximum time between queued voices" Padding="0" FontWeight="SemiBold" />
                                    <Slider x:Name="InterMessageGapSlider" Grid.Column="1" TabIndex="5"
                                            Minimum="0" Maximum="50" Margin="14,0"
                                            Value="{Binding InterMessageGapTenths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TickFrequency="1" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="{Binding InterMessageGapAccessibleText}"
                                            AutomationProperties.HelpText="Use Left and Right Arrow keys to choose zero through five seconds in one-tenth-second steps. Zero gives the closest possible handoff between pre-synthesized queued messages." />
                                    <TextBlock Grid.Column="2" Text="{Binding InterMessageGapDisplay}"
                                               VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                               AutomationProperties.Name="{Binding InterMessageGapAccessibleText}"
                                               AutomationProperties.LiveSetting="Polite"
                                               a11y:LiveRegion.Announcement="{Binding InterMessageGapAccessibleText}" />
                                </Grid>
                                <CheckBox TabIndex="6" Margin="0,8,0,0"
                                          IsChecked="{Binding AdaptiveInterMessageGap, Mode=TwoWay}"
                                          Content="Shorten the delay automatically when the queue is busy"
                                          AutomationProperties.Name="Adaptive queued-voice spacing"
                                          AutomationProperties.HelpText="When enabled, SafeSpeak uses the selected value as the maximum delay, cuts it in half with two queued messages, uses one quarter with five, and removes it with ten or more. Speech never overlaps." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Broadcast output" Style="{StaticResource SectionTitle}" FontSize="{DynamicResource SafeSpeakFont17}" />
                                <CheckBox TabIndex="7" IsChecked="{Binding BroadcastOutputEnabled}" Margin="0,7,0,7"
                                          Content="Send approved speech to the stream output"
                                          AutomationProperties.HelpText="When checked, approved TTS audio plays through the selected broadcast output device." />
                                <Label Target="{Binding ElementName=OutputCombo}" Content="Output device" Padding="0,0,0,4" />
                                <ComboBox x:Name="OutputCombo" TabIndex="8"
                                          ItemsSource="{Binding AudioEndpoints}"
                                          SelectedValuePath="Id" SelectedValue="{Binding SelectedAudioEndpoint}"
                                          PreviewKeyDown="SelectionComboBox_PreviewKeyDown"
                                          AutomationProperties.Name="Broadcast audio device"
                                          AutomationProperties.HelpText="Press Enter, Space, Alt plus Down Arrow, or F4 to open the device list without changing the current output. Then use Arrow keys and Enter to select.">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"
                                               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContentPanel}">
                            <StackPanel>
                                <TextBlock Text="Local neural voices" Style="{StaticResource SectionTitle}" FontSize="{DynamicResource SafeSpeakFont17}" />
                                <TextBlock Text="{Binding KokoroInstallationStatus}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,4,0,8" />
                                <Grid Visibility="{Binding ShowKokoroInstallAction, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button TabIndex="9" HorizontalAlignment="Stretch"
                                            Command="{Binding InstallKokoroCommand}"
                                            IsEnabled="{Binding IsDownloadingVoice, Converter={StaticResource InverseBoolConverter}}"
                                            Content="Install 27 local neural voices"
                                            AutomationProperties.Name="Install 27 offline Kokoro neural voices button, approximately 330 megabyte download" />
                                    <ProgressBar Height="8" VerticalAlignment="Bottom" Minimum="0" Maximum="100"
                                                 Value="{Binding VoiceDownloadProgress}"
                                                 Visibility="{Binding IsDownloadingVoice, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Settings -->
            <TabItem Header="Settings" AutomationProperties.Name="Settings tab, four of four">
                <ScrollViewer x:Name="SettingsPageScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsPanel" Margin="14,12,14,10" MaxWidth="760"
                                KeyboardNavigation.TabNavigation="Local"
                                PreviewKeyDown="SettingsPanel_PreviewKeyDown">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" FontSize="{DynamicResource SafeSpeakFont26}" />

                        <Border x:Name="SettingsGuideControlsTop" Style="{StaticResource ContentPanel}" Margin="0,7,0,10"
                                Visibility="{Binding AreSettingsGuideControlsAtTop, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Settings guide controls" FontWeight="SemiBold"
                                           FontSize="{DynamicResource SafeSpeakFont17}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel>
                                        <Button x:Name="SettingsGuideButton" TabIndex="1" Margin="0,0,7,5"
                                                Command="{Binding ReadSettingsGuideCommand}"
                                                Content="Play whole guide"
                                                AutomationProperties.Name="Play the whole Settings guide button"
                                                AutomationProperties.HelpText="Reads all eight Settings guide pages through SafeSpeak built-in guidance. Use Shut up built-in guidance to stop playback." />
                                        <Button x:Name="ReadSettingsGuidePageButton" TabIndex="2" Margin="0,0,7,5"
                                                Command="{Binding ReadNextSettingsGuidePageCommand}"
                                                Content="Play guide page"
                                                AutomationProperties.Name="Play the next Settings guide page button"
                                                AutomationProperties.HelpText="Reads one Settings guide page and advances to the next page, wrapping to page 1 after page 8." />
                                        <Button x:Name="ResetSettingsGuideButton" TabIndex="3" Margin="0,0,7,5"
                                                Command="{Binding RestartSettingsGuideCommand}"
                                                Content="Reset guide"
                                                AutomationProperties.Name="Reset the Settings guide to page 1 button"
                                                AutomationProperties.HelpText="Returns the Settings guide to page 1 without starting playback." />
                                    </WrapPanel>
                                    <Button x:Name="ToggleSettingsGuideButton" Grid.Column="1" TabIndex="4" Margin="7,0,0,5"
                                            Command="{Binding ToggleSettingsGuideVisibilityCommand}"
                                            Click="GuidePlacementButton_Click"
                                            Content="{Binding SettingsGuideVisibilityButtonText}"
                                            AutomationProperties.Name="{Binding SettingsGuideVisibilityButtonAutomationName}"
                                            AutomationProperties.HelpText="Moves all four Settings guide controls, including this button, to the bottom of the page. Navigate to the bottom of the Settings page to find this button again, labeled Move controls to top. The guide text remains visible." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Label x:Name="SettingsSourceChapterHeading" TabIndex="5" Style="{StaticResource ChapterHeading}"
                                       Content="Chapter 1 — Live stream source"
                                       AutomationProperties.Name="Settings chapter 1 of 9, live stream source"
                                       AutomationProperties.HelpText="The following controls choose and connect the livestream source." />
                                <TextBlock Text="Choose TikFinity or test a direct connection to a public TikTok LIVE stream. Saving a source disarms SafeSpeak and clears queued speech."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <Label Target="{Binding ElementName=SourceConnectorSelector}"
                                       Content="Connection" Padding="0" FontWeight="SemiBold" />
                                <ComboBox x:Name="SourceConnectorSelector" TabIndex="6"
                                          ItemsSource="{Binding SourceConnectorChoices}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedSourceConnectorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          PreviewKeyDown="SelectionComboBox_PreviewKeyDown"
                                          AutomationProperties.Name="Live stream source connection"
                                          AutomationProperties.HelpText="Press Alt plus Down Arrow to open the choices. Select TikFinity or TikTok Direct by username, then choose Save source and connect." />
                                <Label Target="{Binding ElementName=TikTokUsernameTextBox}"
                                       Content="TikTok username" Padding="0" Margin="0,8,0,0" FontWeight="SemiBold" />
                                <TextBox x:Name="TikTokUsernameTextBox" TabIndex="7"
                                         Text="{Binding TikTokUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="24"
                                         AutomationProperties.Name="TikTok creator username"
                                         AutomationProperties.HelpText="Enter the creator username without the at sign. It is used only when TikTok Direct is selected." />
                                <Button TabIndex="8" Margin="0,9,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource CommandButton}"
                                        Command="{Binding SaveAndConnectSourceCommand}"
                                        Content="Save source and connect"
                                        AutomationProperties.Name="Save live stream source and connect button"
                                        AutomationProperties.HelpText="Disconnects the current source, disarms SafeSpeak, clears queued speech, saves this selection, and connects." />
                                <TextBlock Text="{Binding SourceDescription}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                           AutomationProperties.Name="{Binding SourceDescription}" />
                            </StackPanel>
                        </Border>

                        <Label TabIndex="9" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 2 — Theme and spoken accessibility"
                               AutomationProperties.Name="Settings chapter 2 of 9, theme and spoken accessibility"
                               AutomationProperties.HelpText="The following controls choose the visual theme and configure SafeSpeak built-in spoken guidance." />
                        <Label Target="{Binding ElementName=ThemeSelector}" Content="Theme" Padding="0" Margin="0,9,0,5" FontWeight="SemiBold" />
                        <ListBox x:Name="ThemeSelector" TabIndex="10" Focusable="True" IsTabStop="True"
                                 ItemsSource="{Binding ThemeChoices}"
                                 SelectedValuePath="Value"
                                 SelectedValue="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="132" Padding="0" BorderThickness="0" Background="Transparent"
                                 KeyboardNavigation.TabNavigation="Once"
                                 PreviewKeyDown="ThemeSelector_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="ThemeSelector_PreviewMouseLeftButtonDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Theme selector"
                                 AutomationProperties.ItemStatus="{Binding ThemeSelectionAccessibleText}"
                                 AutomationProperties.HelpText="Use Left and Right or Up and Down Arrow keys to choose Light, Dark, or High Contrast. Each option is announced as it is selected.">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                    <Setter Property="AutomationProperties.PositionInSet" Value="{Binding Position}" />
                                    <Setter Property="AutomationProperties.SizeOfSet" Value="3" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ThemeCard"
                                                        Padding="8"
                                                        Background="{DynamicResource SafeSpeakSurfaceBrush}"
                                                        BorderBrush="{DynamicResource SafeSpeakBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThemeCard" Property="Background" Value="{DynamicResource SafeSpeakAccentSoftBrush}" />
                                                        <Setter TargetName="ThemeCard" Property="BorderBrush" Value="{DynamicResource SafeSpeakAccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ThemeCard" Property="BorderBrush" Value="{DynamicResource SafeSpeakAccentBrush}" />
                                                        <Setter TargetName="ThemeCard" Property="BorderThickness" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border x:Name="ThemePreview" Height="70" Margin="0,0,0,6"
                                                Background="#FFF7F8FC" BorderBrush="#FFC7D0E0"
                                                BorderThickness="1" CornerRadius="3">
                                            <Grid Margin="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="10" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border x:Name="PreviewHeader" Background="#FFD7DEEA" CornerRadius="1" />
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Border x:Name="PreviewLineOne" Height="6" Width="58" HorizontalAlignment="Left" Background="#FF9BA8BA" />
                                                        <Border x:Name="PreviewLineTwo" Height="6" Width="43" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#FFC7D0E0" />
                                                    </StackPanel>
                                                    <Border x:Name="PreviewAction" Grid.Column="1" Height="24" VerticalAlignment="Center" Background="#FF2057D4" CornerRadius="2" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DisplayName}" Value="Dark">
                                            <Setter TargetName="ThemePreview" Property="Background" Value="#FF121C2C" />
                                            <Setter TargetName="ThemePreview" Property="BorderBrush" Value="#FF94A3B8" />
                                            <Setter TargetName="PreviewHeader" Property="Background" Value="#FF28364B" />
                                            <Setter TargetName="PreviewLineOne" Property="Background" Value="#FFCBD5E1" />
                                            <Setter TargetName="PreviewLineTwo" Property="Background" Value="#FF718096" />
                                            <Setter TargetName="PreviewAction" Property="Background" Value="#FF3B82F6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DisplayName}" Value="High Contrast">
                                            <Setter TargetName="ThemePreview" Property="Background" Value="#FF000000" />
                                            <Setter TargetName="ThemePreview" Property="BorderBrush" Value="#FFFFFF00" />
                                            <Setter TargetName="PreviewHeader" Property="Background" Value="#FFFFFFFF" />
                                            <Setter TargetName="PreviewLineOne" Property="Background" Value="#FFFFFF00" />
                                            <Setter TargetName="PreviewLineTwo" Property="Background" Value="#FFFFFFFF" />
                                            <Setter TargetName="PreviewAction" Property="Background" Value="#FFFFFF00" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding ThemeStatus}" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,4,0,10"
                                   AutomationProperties.Name="{Binding ThemeStatus}"
                                   AutomationProperties.LiveSetting="Polite"
                                   a11y:LiveRegion.Announcement="{Binding ThemeStatus}" />

                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="SpokenGuidanceToggle" TabIndex="11"
                                          IsChecked="{Binding SpokenGuidanceEnabled, Mode=TwoWay}"
                                          Content="Use SafeSpeak built-in spoken guidance"
                                          AutomationProperties.Name="Use SafeSpeak built-in spoken guidance"
                                          AutomationProperties.HelpText="Independent of the visual theme. Turn this off when using Windows Narrator, NVDA, or JAWS if two voices speak at once. Built-in guidance and its sound cues use the selected guidance audio device." />
                                <TextBlock Text="{Binding SpokenGuidanceStatus}"
                                           Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           AutomationProperties.Name="{Binding SpokenGuidanceStatus}"
                                           AutomationProperties.LiveSetting="Polite"
                                           a11y:LiveRegion.Announcement="{Binding SpokenGuidanceStatus}" />
                                <Label Target="{Binding ElementName=GuidanceOutputCombo}"
                                       Content="Guidance and sound-cue output" Padding="0" Margin="0,7,0,2" />
                                <ComboBox x:Name="GuidanceOutputCombo" TabIndex="12"
                                          ItemsSource="{Binding AudioEndpoints}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedGuidanceAudioEndpoint, Mode=TwoWay}"
                                          PreviewKeyDown="SelectionComboBox_PreviewKeyDown"
                                          AutomationProperties.Name="Built-in guidance and sound-cue audio device"
                                          AutomationProperties.ItemStatus="{Binding GuidanceAudioEndpointAccessibleText}"
                                          AutomationProperties.HelpText="Press Enter, Space, Alt plus Down Arrow, or F4 to open the device list without changing the current output. Then use Arrow keys and Enter to choose a private headset or another Windows output for SafeSpeak interface narration and sound cues. This does not change livestream text to speech." />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=ReaderVolumeSlider}" Content="Guidance volume" Padding="0" />
                                    <Slider x:Name="ReaderVolumeSlider" Grid.Column="1" TabIndex="13" Minimum="0" Maximum="150" Margin="12,0"
                                            Value="{Binding ReaderSpeechVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TickFrequency="5" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="Built-in guidance volume slider from 0 to 150 percent"
                                            AutomationProperties.HelpText="Use Left and Right Arrow keys to adjust the built-in narrator and sound-cue volume in five percent steps. 100 percent is the default; values above 100 add software amplification and may clip on louder voices. Livestream narration volume is separate." />
                                    <TextBlock Grid.Column="2" Text="{Binding ReaderSpeechVolume, StringFormat={}{0}%}"
                                               VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                               AutomationProperties.Name="{Binding ReaderSpeechVolume, StringFormat=Guidance volume {0} percent}" />
                                </Grid>
                                <Button TabIndex="14" Margin="0,7,0,0" HorizontalAlignment="Left"
                                        Command="{Binding TestGuidanceAudioCommand}"
                                        Content="Test guidance audio"
                                        AutomationProperties.Name="Test built-in guidance audio button"
                                        AutomationProperties.HelpText="Speaks a test phrase through the selected guidance audio device at the selected volume." />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=ReaderRateSlider}" Content="Reader speed" Padding="0" />
                                    <Slider x:Name="ReaderRateSlider" Grid.Column="1" TabIndex="15" Minimum="-5" Maximum="5" Margin="12,0,0,0"
                                            Value="{Binding ReaderSpeechRate}" TickFrequency="1" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="Built-in screen reader speech speed slider"
                                            AutomationProperties.HelpText="Use Left and Right Arrow keys to adjust built-in reader speed one step at a time." />
                                </Grid>
                                <CheckBox TabIndex="16" Margin="0,7,0,0"
                                          IsChecked="{Binding NarrateDetailedHelp, Mode=TwoWay}"
                                          Content="Detailed narrator descriptions"
                                          AutomationProperties.Name="Detailed narrator descriptions"
                                          AutomationProperties.HelpText="When checked, the built-in narrator reads each focused control's full description and navigation instructions. When unchecked, it reads only the control name, current value or state, and control type." />
                                <TextBlock Text="Checked: full descriptions and navigation instructions. Unchecked: shorter, direct control names, values, and states."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,2,0,0" />
                                <CheckBox TabIndex="17" Margin="0,5,0,0"
                                          IsChecked="{Binding NarrateTypedCharacters, Mode=TwoWay}"
                                          Content="Echo typed characters"
                                          AutomationProperties.Name="Echo typed characters with built-in guidance"
                                          AutomationProperties.HelpText="Speaks characters entered in ordinary edit boxes. Passwords are never exposed because SafeSpeak has no spoken password fields." />
                                <Button TabIndex="18" Margin="0,9,0,0" HorizontalAlignment="Left"
                                        Command="{Binding StopBuiltInGuidanceCommand}"
                                        Content="Shut up built-in guidance"
                                        AutomationProperties.Name="Shut up button, stop SafeSpeak built-in spoken guidance"
                                        AutomationProperties.HelpText="{Binding StopBuiltInGuidanceHelpText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Label TabIndex="19" Style="{StaticResource ChapterHeading}"
                                       Content="Chapter 3 — Global keyboard shortcuts"
                                       AutomationProperties.Name="Settings chapter 3 of 9, global keyboard shortcuts"
                                       AutomationProperties.HelpText="The following controls configure actions that work system-wide while SafeSpeak is running." />
                                <TextBlock Text="Shortcuts work system-wide while SafeSpeak is running, even when another application has focus. Tab to Enter keybind group, press Enter, then Tab through the action boxes. Activate an action, press the complete key combination once, and repeat the same combination to confirm it. Save and close activates the verified shortcut. Press Escape or choose Exit keybind group when finished. Function keys can be used alone; other non-modifier keys require Control, Alt, Shift, or Windows. Alt plus 1 through 9 opens that chapter on the current page; Alt plus 0 opens chapter 10. If an Alt-number is assigned as a custom global shortcut, that action takes priority and the matching chapter shortcut is unavailable until the binding is changed or disabled."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <Button x:Name="GlobalShortcutGroupEntry" TabIndex="20"
                                        Margin="0,0,0,7" Padding="10" HorizontalContentAlignment="Left"
                                        Click="GlobalShortcutGroupEntry_Click"
                                        Content="Enter keybind group"
                                        AutomationProperties.Name="Keybind group. Press Enter to enter the global shortcut action group."
                                        AutomationProperties.HelpText="This is one normal Tab stop. Press Enter or Space to make the action boxes tabbable. Inside the group, press Escape or choose Exit keybind group to return here." />
                                <TextBlock x:Name="GlobalShortcutGroupStatus"
                                           Text="Keybind group inactive. Press Enter on the Enter keybind group button to navigate its actions."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,7"
                                           AutomationProperties.LiveSetting="Assertive"
                                           a11y:LiveRegion.Announcement="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <StackPanel x:Name="GlobalShortcutNavigationGroup"
                                            KeyboardNavigation.TabNavigation="Cycle"
                                            PreviewKeyDown="GlobalShortcutNavigationGroup_PreviewKeyDown">
                                    <Button x:Name="ExitGlobalShortcutGroupButton"
                                            Margin="0,0,0,7" Padding="9" HorizontalAlignment="Left"
                                            Visibility="Collapsed" IsTabStop="False"
                                            Click="ExitGlobalShortcutGroupButton_Click"
                                            Content="Exit keybind group"
                                            AutomationProperties.Name="Exit keybind group and return to its main Settings tab stop" />

                                    <Border x:Name="InlineShortcutCapturePanel"
                                            Style="{StaticResource StatusCard}" Margin="0,0,0,9"
                                            Padding="12" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="InlineShortcutCaptureHeading"
                                                       FontWeight="SemiBold" FontSize="{DynamicResource SafeSpeakFont17}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.HeadingLevel="Level3" />
                                            <TextBlock x:Name="InlineShortcutCaptureDescription"
                                                       Margin="0,4,0,8" TextWrapping="Wrap" />
                                            <Button x:Name="InlineShortcutCaptureButton"
                                                    MinHeight="70" Padding="10"
                                                    PreviewKeyDown="InlineShortcutCaptureButton_PreviewKeyDown"
                                                    PreviewKeyUp="InlineShortcutCaptureButton_PreviewKeyUp"
                                                    LostKeyboardFocus="InlineShortcutCaptureButton_LostKeyboardFocus"
                                                    AutomationProperties.Name="Shortcut listener. Press the complete shortcut combination now."
                                                    AutomationProperties.HelpText="SafeSpeak captures one trigger key with any combination of Control, Alt, Shift, and Windows. Repeat the same complete combination to verify it before saving.">
                                                <StackPanel>
                                                    <TextBlock Text="Shortcut listener" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="InlinePendingShortcutText" Text="Press the shortcut once"
                                                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <CheckBox x:Name="InlineShortcutEnabledCheckBox" Margin="0,9,0,0"
                                                      Content="Enable this shortcut system-wide"
                                                      AutomationProperties.Name="Enable this shortcut system-wide after it is verified and saved" />
                                            <Button Margin="0,8,0,0" Padding="8" HorizontalAlignment="Left"
                                                    Click="InlineClearShortcutButton_Click"
                                                    Content="Clear and disable shortcut"
                                                    AutomationProperties.Name="Clear and disable this shortcut"
                                                    AutomationProperties.HelpText="Stages removal of this shortcut. Save and close is still required." />
                                            <TextBlock x:Name="InlineShortcutCaptureStatus" Margin="0,8,0,0"
                                                       Text="No replacement has been captured."
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Assertive"
                                                       a11y:LiveRegion.Announcement="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button x:Name="InlineSaveShortcutButton" Margin="0,0,7,0" Padding="9,7"
                                                        IsEnabled="False" Click="InlineSaveShortcutButton_Click"
                                                        Content="Save and close"
                                                        AutomationProperties.Name="Save the verified shortcut and close this inline listener" />
                                                <Button Padding="9,7" Click="InlineCancelShortcutButton_Click"
                                                        Content="Cancel"
                                                        AutomationProperties.Name="Cancel shortcut capture without changing the saved shortcut" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl x:Name="GlobalShortcutGrid"
                                                  ItemsSource="{Binding GlobalShortcutEditors}"
                                                  AutomationProperties.Name="Global shortcut action boxes">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="GlobalShortcutActionCard"
                                                        IsTabStop="False"
                                                        Margin="0,0,7,7" Padding="10" MinHeight="72"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="GlobalShortcutActionCard_Click"
                                                        AutomationProperties.Name="{Binding CardAutomationName}"
                                                        AutomationProperties.HelpText="{Binding CardHelpText}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding GestureDisplay}" Margin="0,4,0,0"
                                                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <WrapPanel Margin="0,2,0,0">
                                    <Button TabIndex="21" Margin="0,0,0,5"
                                            Command="{Binding RestoreDefaultGlobalShortcutsCommand}"
                                            Content="Restore all defaults"
                                            AutomationProperties.Name="Restore all global shortcut defaults button"
                                            AutomationProperties.HelpText="Restores, saves, and activates every SafeSpeak shortcut default immediately." />
                                </WrapPanel>
                                <TextBlock Text="{Binding GlobalShortcutStatus}"
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           AutomationProperties.Name="{Binding GlobalShortcutStatus}"
                                           AutomationProperties.LiveSetting="Polite"
                                           a11y:LiveRegion.Announcement="{Binding GlobalShortcutStatus}" />
                                <TextBlock Text="Privacy note: audit logging cannot be assigned to a global shortcut because turning it on requires deliberate consent in SafeSpeak Settings."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="Fixed page shortcuts inside SafeSpeak" FontWeight="SemiBold" Margin="0,9,0,2" />
                                <ItemsControl ItemsSource="{Binding ApplicationKeyboardShortcuts}" IsTabStop="False"
                                              AutomationProperties.Name="Fixed SafeSpeak application shortcuts">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button TabIndex="22" Margin="0,7,0,0" HorizontalAlignment="Left"
                                        Command="{Binding ReadFixedApplicationShortcutsCommand}"
                                        Content="Read fixed page shortcuts aloud"
                                        AutomationProperties.Name="Read SafeSpeak page and chapter navigation shortcuts aloud button"
                                        AutomationProperties.HelpText="Reads Control plus 1, 2, 3, and 4 for opening the Live, Safety, Voice, and Settings pages. All action shortcuts are configured above." />
                            </StackPanel>
                        </Border>

                        <Label TabIndex="23" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 4 — Queue and message-rate limits"
                               AutomationProperties.Name="Settings chapter 4 of 9, queue and message-rate limits"
                               AutomationProperties.HelpText="The following controls set the pending queue size and per-viewer and whole-stream spam limits." />
                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=QueueLimitSlider}"
                                           Content="Approved message queue limit" Padding="0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding QueueLimit}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding QueueLimitAccessibleText}"
                                               AutomationProperties.LiveSetting="Polite"
                                               a11y:LiveRegion.Announcement="{Binding QueueLimitAccessibleText}" />
                                </Grid>
                                <Slider x:Name="QueueLimitSlider" TabIndex="24"
                                        Minimum="1" Maximum="500" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding QueueLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{Binding QueueLimitAccessibleText}"
                                        AutomationProperties.HelpText="Use Left and Right Arrow keys to set the maximum number of pending approved items from 1 through 500. Lowering the limit does not delete items already waiting." />
                                <TextBlock Text="New approved items are held when this limit is reached. Lowering the limit never removes items already waiting; new items can enter again after the queue drops below the selected limit."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Message spam limits" Style="{StaticResource SectionTitle}"
                                           FontSize="{DynamicResource SafeSpeakFont17}" />
                                <CheckBox TabIndex="25" Margin="0,7,0,5"
                                          IsChecked="{Binding MessageRateLimitEnabled, Mode=TwoWay}"
                                          Content="Limit how quickly chat messages can enter SafeSpeak"
                                          AutomationProperties.Name="Enable adjustable message spam limits"
                                          AutomationProperties.HelpText="Turns both per-viewer and whole-stream sliding limits on or off. The controls below remain available while off so their saved values can be prepared before enabling the limits." />
                                <Label Target="{Binding ElementName=MessageRateWindowSelector}"
                                       Content="Count messages" Padding="0" Margin="0,4,0,4" />
                                <ComboBox x:Name="MessageRateWindowSelector" TabIndex="26"
                                          ItemsSource="{Binding MessageRateWindowChoices}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedMessageRateWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          PreviewKeyDown="SelectionComboBox_PreviewKeyDown"
                                          AutomationProperties.Name="Message spam limit time window selector"
                                          AutomationProperties.ItemStatus="{Binding MessageRateWindowAccessibleText}"
                                          AutomationProperties.HelpText="Press Enter, Space, Alt plus Down Arrow, or F4 to open the time-window list without changing the current value. Then use Arrow keys and Enter to choose whether limits are counted per one second or per ten seconds.">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                            <Setter Property="AutomationProperties.PositionInSet" Value="{Binding Position}" />
                                            <Setter Property="AutomationProperties.SizeOfSet" Value="2" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       AutomationProperties.Name="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=PerUserMessageLimitSlider}"
                                           Content="Maximum messages from one viewer" Padding="0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding PerUserMessageLimit}"
                                               FontWeight="SemiBold" AutomationProperties.Name="{Binding PerUserMessageLimitAccessibleText}"
                                               AutomationProperties.LiveSetting="Polite"
                                               a11y:LiveRegion.Announcement="{Binding PerUserMessageLimitAccessibleText}" />
                                </Grid>
                                <Slider x:Name="PerUserMessageLimitSlider" TabIndex="27"
                                        Minimum="1" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding PerUserMessageLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{Binding PerUserMessageLimitAccessibleText}"
                                        AutomationProperties.HelpText="Use Left and Right Arrow keys to set the maximum accepted messages from one viewer in the selected time window, from 1 through 100." />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=StreamMessageLimitSlider}"
                                           Content="Maximum messages from the whole stream" Padding="0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding StreamMessageLimit}"
                                               FontWeight="SemiBold" AutomationProperties.Name="{Binding StreamMessageLimitAccessibleText}"
                                               AutomationProperties.LiveSetting="Polite"
                                               a11y:LiveRegion.Announcement="{Binding StreamMessageLimitAccessibleText}" />
                                </Grid>
                                <Slider x:Name="StreamMessageLimitSlider" TabIndex="28"
                                        Minimum="10" Maximum="5000" TickFrequency="10" SmallChange="10" LargeChange="100"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding StreamMessageLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{Binding StreamMessageLimitAccessibleText}"
                                        AutomationProperties.HelpText="Use Left and Right Arrow keys to set the whole-stream accepted-message limit from 10 through 5000. The default is 500 per ten seconds for larger streams." />
                                <TextBlock Text="Defaults: 3 messages per viewer and 500 messages across the stream in 10 seconds. Limits use a rolling time window and count incoming chat before moderation or speech; event announcements are not counted."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ContentPanel}" VerticalAlignment="Stretch">
                                <StackPanel>
                                    <Label TabIndex="29" Style="{StaticResource ChapterHeading}"
                                           Content="Chapter 5 — Language and audience"
                                           AutomationProperties.Name="Settings chapter 5 of 9, language and audience"
                                           AutomationProperties.HelpText="The following controls choose writing-system protection and who may send messages to speech." />
                                    <CheckBox TabIndex="30" IsChecked="{Binding EnglishOnly}" Margin="0,7,0,3"
                                              Content="Filter to English and Latin-script chat"
                                              AutomationProperties.Name="Filter chat to English and Latin script"
                                              AutomationProperties.HelpText="When enabled, unsupported writing systems are blocked before speech." />
                                    <CheckBox TabIndex="31" IsChecked="{Binding RejectMixedScripts}" Margin="0,3"
                                              Content="Block mixed-script evasion"
                                              AutomationProperties.Name="Block mixed-script evasion"
                                              AutomationProperties.HelpText="Blocks words that mix writing systems to disguise banned or hostile language." />
                                    <Label Target="{Binding ElementName=AudienceSelector}"
                                           Content="Chat audience" Padding="0" Margin="0,7,0,4" />
                                    <ComboBox x:Name="AudienceSelector" TabIndex="32"
                                              ItemsSource="{Binding AudienceChoices}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedAudienceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              PreviewKeyDown="SelectionComboBox_PreviewKeyDown"
                                              AutomationProperties.Name="Chat audience selector"
                                              AutomationProperties.ItemStatus="{Binding AudienceSelectionAccessibleText}"
                                              AutomationProperties.HelpText="Press Enter, Space, Alt plus Down Arrow, or F4 to open the audience list without changing the current value. Then use Arrow keys and Enter to choose Everyone, Followers, Subscribers, or Moderators.">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                                <Setter Property="AutomationProperties.PositionInSet" Value="{Binding Position}" />
                                                <Setter Property="AutomationProperties.SizeOfSet" Value="4" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           AutomationProperties.Name="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox TabIndex="33" IsChecked="{Binding AllowDonorsToSpeak}" Margin="0,7,0,0"
                                              Content="Also allow current-stream gift senders"
                                              AutomationProperties.Name="Allow current-stream gift senders to speak"
                                              AutomationProperties.HelpText="When enabled, a person who sends a gift during this armed session may speak even if they do not meet the selected audience tier. Their name and message are still moderated." />
                                    <TextBlock Text="{Binding RequiredSafetyFeaturesStatus}"
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0"
                                               AutomationProperties.Name="{Binding RequiredSafetyFeaturesStatus}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Label TabIndex="34" Style="{StaticResource ChapterHeading}"
                                               Content="Chapter 6 — Stream announcements"
                                               AutomationProperties.Name="Settings chapter 6 of 9, stream announcements"
                                               AutomationProperties.HelpText="The following controls choose which stream events may enter speech, including behavior while paused." />
                                        <UniformGrid Columns="2" Margin="0,5,0,0">
                                            <CheckBox TabIndex="35" IsChecked="{Binding AnnounceChatMessages}" Margin="0,3"
                                                      Content="Chat" AutomationProperties.Name="Announce chat messages"
                                                      AutomationProperties.HelpText="Controls whether approved chat messages enter the text-to-speech queue." />
                                            <CheckBox TabIndex="36" IsChecked="{Binding AnnounceGifts}" Margin="0,3"
                                                      Content="Gifts" AutomationProperties.Name="Announce gifts"
                                                      AutomationProperties.HelpText="Controls spoken gift announcements." />
                                            <CheckBox TabIndex="37" IsChecked="{Binding AnnounceFollows}" Margin="0,3"
                                                      Content="Follows" AutomationProperties.Name="Announce follows"
                                                      AutomationProperties.HelpText="Controls spoken follow announcements." />
                                            <CheckBox TabIndex="38" IsChecked="{Binding AnnounceShares}" Margin="0,3"
                                                      Content="Shares" AutomationProperties.Name="Announce shares"
                                                      AutomationProperties.HelpText="Controls spoken share announcements." />
                                            <CheckBox TabIndex="39" IsChecked="{Binding AnnounceSubscriptions}" Margin="0,3"
                                                      Content="Subscriptions" AutomationProperties.Name="Announce subscriptions"
                                                      AutomationProperties.HelpText="Controls spoken subscription announcements." />
                                            <CheckBox TabIndex="40" IsChecked="{Binding AnnounceJoins}" Margin="0,3"
                                                      Content="Joins" AutomationProperties.Name="Announce viewer joins"
                                                      AutomationProperties.HelpText="Controls spoken viewer-join announcements." />
                                            <CheckBox TabIndex="41" IsChecked="{Binding AnnounceLikes}" Margin="0,3"
                                                      Content="Likes" AutomationProperties.Name="Announce likes"
                                                      AutomationProperties.HelpText="Controls spoken like announcements." />
                                        </UniformGrid>
                                        <Border BorderBrush="{DynamicResource SafeSpeakBorderBrush}"
                                                BorderThickness="0,1,0,0" Margin="0,7,0,5" />
                                        <TextBlock Text="While paused" FontWeight="SemiBold" />
                                        <CheckBox TabIndex="42" IsChecked="{Binding PauseAllTtsWhilePaused}" Margin="0,5,0,3"
                                                  Content="Pause all TTS, including events"
                                                  AutomationProperties.Name="Pause all text to speech including event announcements"
                                                  AutomationProperties.HelpText="When checked, every approved message and event waits until TTS resumes. Emergency Stop always stops and clears everything." />
                                        <UniformGrid Columns="2" KeyboardNavigation.TabNavigation="Local">
                                            <CheckBox TabIndex="43" IsChecked="{Binding AllowGiftAnnouncementsWhilePaused}"
                                                      Margin="0,3" Content="Allow gifts"
                                                      AutomationProperties.Name="Allow gift announcements while chat TTS is paused"
                                                      AutomationProperties.HelpText="Sets whether gifts may speak while paused when Pause all TTS is unchecked. This option remains keyboard accessible so it can be prepared in advance." />
                                            <CheckBox TabIndex="44" IsChecked="{Binding AllowFollowAnnouncementsWhilePaused}"
                                                      Margin="0,3" Content="Allow follows"
                                                      AutomationProperties.Name="Allow follow announcements while chat TTS is paused"
                                                      AutomationProperties.HelpText="Sets whether follows may speak while paused when Pause all TTS is unchecked. This option remains keyboard accessible so it can be prepared in advance." />
                                            <CheckBox TabIndex="45" IsChecked="{Binding AllowShareAnnouncementsWhilePaused}"
                                                      Margin="0,3" Content="Allow shares"
                                                      AutomationProperties.Name="Allow share announcements while chat TTS is paused"
                                                      AutomationProperties.HelpText="Sets whether shares may speak while paused when Pause all TTS is unchecked. This option remains keyboard accessible so it can be prepared in advance." />
                                            <CheckBox TabIndex="46" IsChecked="{Binding AllowSubscriptionAnnouncementsWhilePaused}"
                                                      Margin="0,3" Content="Allow subscriptions"
                                                      AutomationProperties.Name="Allow subscription announcements while chat TTS is paused"
                                                      AutomationProperties.HelpText="Sets whether subscriptions may speak while paused when Pause all TTS is unchecked. This option remains keyboard accessible so it can be prepared in advance." />
                                        </UniformGrid>
                                        <TextBlock Text="{Binding PauseRoutingSummary}" Style="{StaticResource SecondaryText}"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                                   AutomationProperties.Name="{Binding PauseRoutingSummary}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   a11y:LiveRegion.Announcement="{Binding PauseRoutingSummary}" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>

                        <Label TabIndex="47" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 7 — Privacy and audit logs"
                               AutomationProperties.Name="Settings chapter 7 of 9, privacy and audit logs"
                               AutomationProperties.HelpText="The following controls enable local moderation logs and open their folder." />
                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox TabIndex="48" IsChecked="{Binding EnableStreamAuditLogging}"
                                          Content="Save chat and moderation decisions to a local text log"
                                          AutomationProperties.Name="Save chat and moderation decisions to a local text log"
                                          AutomationProperties.HelpText="When enabled, raw chat, usernames, gifts, and safety decisions are saved locally for post-stream review." />
                                <TextBlock Text="Logs can include usernames, raw chat, and blocked text. Logging is off until you enable it."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,7"
                                           Foreground="{DynamicResource SafeSpeakDangerBrush}" />
                                <TextBlock Text="{Binding AuditLogsDirectoryDisplay, StringFormat=Log folder: {0}}"
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,7"
                                           AutomationProperties.Name="{Binding AuditLogsDirectoryDisplay, StringFormat=SafeSpeak log folder: {0}}" />
                                <Button TabIndex="49" HorizontalAlignment="Left"
                                        Command="{Binding OpenAuditLogsFolderCommand}"
                                        Content="Open logs folder"
                                        AutomationProperties.Name="Open stream audit logs folder button"
                                        AutomationProperties.HelpText="Opens the displayed local folder. If Windows cannot open it, SafeSpeak writes and announces an error." />
                            </StackPanel>
                        </Border>

                        <Label TabIndex="50" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 8 — Interface and setup"
                               AutomationProperties.Name="Settings chapter 8 of 9, interface and setup"
                               AutomationProperties.HelpText="The following controls change interface text size or run the accessibility setup again." />
                        <Border Style="{StaticResource ContentPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Target="{Binding ElementName=TextScaleSlider}"
                                           Content="Interface text size" Padding="0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding InterfaceTextScalePercent, StringFormat={}{0}%}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding InterfaceTextScaleAccessibleText}" />
                                </Grid>
                                <Slider x:Name="TextScaleSlider" TabIndex="51"
                                        Minimum="100" Maximum="200" TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding InterfaceTextScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{Binding InterfaceTextScaleAccessibleText}"
                                        AutomationProperties.HelpText="Use Left and Right Arrow keys to enlarge SafeSpeak text from 100 to 200 percent. Settings pages remain scrollable at large sizes." />
                                <TextBlock Text="Text enlarges immediately and remains at this size after restart. Windows display scaling and high contrast continue to work independently."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Button TabIndex="52" HorizontalAlignment="Stretch"
                                Command="{Binding RerunAccessibilityWizardCommand}"
                                Content="Run Setup Again"
                                AutomationProperties.Name="Run SafeSpeak setup again button"
                                AutomationProperties.HelpText="Reviews streaming-platform, filtering, spoken-guidance, and theme choices. Cancel preserves your current settings, logs, imported voices, and downloaded models." />

                        <Label TabIndex="53" Style="{StaticResource ChapterHeading}"
                               Content="Chapter 9 — Settings guide reference"
                               AutomationProperties.Name="Settings chapter 9 of 9, Settings guide reference"
                               AutomationProperties.HelpText="The following visible reference contains the complete Settings guide. Guide playback controls may be at the top or bottom of this page." />
                        <Border x:Name="SettingsGuidePanel" Style="{StaticResource ContentPanel}" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="Settings guide" FontWeight="SemiBold"
                                           FontSize="{DynamicResource SafeSpeakFont17}" />
                                <ItemsControl ItemsSource="{Binding SettingsGuidePages}" IsTabStop="False" Margin="0,5,0,0"
                                              AutomationProperties.Name="Visible Settings guide pages">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2"
                                                       Style="{StaticResource SecondaryText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsGuideControlsEnd" Style="{StaticResource ContentPanel}" Margin="0,10,0,4"
                                Visibility="{Binding AreSettingsGuideControlsAtEnd, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Settings guide controls, at the bottom of the page"
                                           FontWeight="SemiBold" FontSize="{DynamicResource SafeSpeakFont17}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel>
                                        <Button x:Name="SettingsGuideButtonAtEnd" TabIndex="54" Margin="0,0,7,5"
                                                Command="{Binding ReadSettingsGuideCommand}"
                                                Content="Play whole guide"
                                                AutomationProperties.Name="Play the whole Settings guide button, at the bottom of the page"
                                                AutomationProperties.HelpText="Reads all eight Settings guide pages through SafeSpeak built-in guidance." />
                                        <Button x:Name="ReadSettingsGuidePageButtonAtEnd" TabIndex="55" Margin="0,0,7,5"
                                                Command="{Binding ReadNextSettingsGuidePageCommand}"
                                                Content="Play guide page"
                                                AutomationProperties.Name="Play the next Settings guide page button, at the bottom of the page"
                                                AutomationProperties.HelpText="Reads one Settings guide page and advances to the next page." />
                                        <Button x:Name="ResetSettingsGuideButtonAtEnd" TabIndex="56" Margin="0,0,7,5"
                                                Command="{Binding RestartSettingsGuideCommand}"
                                                Content="Reset guide"
                                                AutomationProperties.Name="Reset the Settings guide to page 1 button, at the bottom of the page"
                                                AutomationProperties.HelpText="Returns the Settings guide to page 1 without starting playback." />
                                    </WrapPanel>
                                    <Button x:Name="ToggleSettingsGuideButtonAtEnd" Grid.Column="1" TabIndex="57" Margin="7,0,0,5"
                                            Command="{Binding ToggleSettingsGuideVisibilityCommand}"
                                            Click="GuidePlacementButton_Click"
                                            Content="{Binding SettingsGuideVisibilityButtonText}"
                                            AutomationProperties.Name="{Binding SettingsGuideVisibilityButtonAutomationName}"
                                            AutomationProperties.HelpText="Moves all four Settings guide controls, including this button, to the top of the page. Navigate to the top of the Settings page to find this button again, labeled Move controls to bottom. The guide text remains visible." />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom Screen Reader Live Announcement Banner -->
        <Border Grid.Row="1" Style="{StaticResource LiveStatusBar}">
            <TextBlock Text="{Binding LiveStatusAnnouncement}" TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding LiveStatusAnnouncement}"
                       AutomationProperties.LiveSetting="Polite"
                       a11y:LiveRegion.Announcement="{Binding LiveStatusAnnouncement}" />
        </Border>
    </Grid>
</Window>
