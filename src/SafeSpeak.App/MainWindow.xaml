<Window x:Class="SafeSpeak.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeSpeak"
        Height="690"
        Width="760"
        MinHeight="620"
        MinWidth="620"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="SafeSpeak control centre">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="30" FontWeight="Bold" Text="SafeSpeak" />
            <TextBlock Margin="0,4,0,18"
                       TextWrapping="Wrap"
                       Text="TTS safety and accessible stream controls" />

            <Border Padding="12" BorderBrush="DarkOrange" BorderThickness="2" CornerRadius="4">
                <TextBlock FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="Development build: live moderation and spoken audio are not active yet. Do not rely on this build to protect a live stream." />
            </Border>

            <GroupBox Margin="0,18,0,0"
                      Header="Current status"
                      AutomationProperties.Name="Current SafeSpeak status">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="TikFinity:" />
                    <TextBlock x:Name="ConnectionValue" Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Text="Disconnected" />
                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="TTS:" />
                    <TextBlock x:Name="ArmedValue" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="Disarmed" />
                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Automatic playback:" />
                    <TextBlock x:Name="AutomaticPlaybackValue" Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Text="Off" />
                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Approved queue:" />
                    <TextBlock x:Name="QueueValue" Grid.Row="3" Grid.Column="1" Margin="12,0,0,0" Text="0 messages" />
                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="English-only mode:" />
                    <TextBlock x:Name="EnglishOnlyValue" Grid.Row="4" Grid.Column="1" Margin="12,0,0,0" Text="On" />
                </Grid>
            </GroupBox>

            <GroupBox Margin="0,18,0,0" Header="TTS controls" AutomationProperties.Name="TTS controls">
                <WrapPanel Margin="8">
                    <Button Margin="4" Padding="14,9" Content="Arm or disarm TTS" Tag="tts.toggleArmed" Click="ControlButton_Click" />
                    <Button Margin="4" Padding="14,9" Content="Toggle automatic playback" Tag="tts.toggleAutomaticPlayback" Click="ControlButton_Click" />
                    <Button Margin="4" Padding="14,9" Content="Play next approved message" Tag="queue.playNext" Click="ControlButton_Click" />
                    <Button Margin="4" Padding="14,9" Content="Skip current message" Tag="queue.skipCurrent" Click="ControlButton_Click" />
                </WrapPanel>
            </GroupBox>

            <GroupBox Margin="0,12,0,0" Header="Queue and safety controls" AutomationProperties.Name="Queue and safety controls">
                <WrapPanel Margin="8">
                    <Button Margin="4" Padding="14,9" Content="Pause or resume queue" Tag="queue.togglePause" Click="ControlButton_Click" />
                    <Button Margin="4" Padding="14,9" Content="Clear queue" Tag="queue.clear" Click="ControlButton_Click" />
                    <Button Margin="4" Padding="14,9" FontWeight="Bold" Content="Emergency stop and clear" Tag="tts.emergencyStop" Click="ControlButton_Click" />
                    <Button Margin="4" Padding="14,9" Content="Report status" Tag="status.announce" Click="ControlButton_Click" />
                    <Button Margin="4" Padding="14,9" Content="Toggle English-only mode" Tag="moderation.toggleEnglishOnly" Click="ControlButton_Click" />
                </WrapPanel>
            </GroupBox>

            <Button Margin="0,18,0,0"
                    Padding="14,9"
                    HorizontalAlignment="Left"
                    Content="Accessibility settings"
                    AutomationProperties.HelpText="Change the screen-reader guidance preference selected during first launch."
                    Click="AccessibilitySettingsButton_Click" />

            <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Latest action" />
            <TextBlock x:Name="LiveStatus"
                       MinHeight="48"
                       Padding="10"
                       Background="#FFF1F1F1"
                       Text="SafeSpeak is starting."
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Latest SafeSpeak action" />
        </StackPanel>
    </ScrollViewer>
</Window>
