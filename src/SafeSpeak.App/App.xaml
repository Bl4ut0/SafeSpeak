<Application x:Class="SafeSpeak.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="SafeSpeakWindowBrush" Color="#FFF7F8FC" />
        <SolidColorBrush x:Key="SafeSpeakSurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SafeSpeakSurfaceAltBrush" Color="#FFF0F3FA" />
        <SolidColorBrush x:Key="SafeSpeakTextBrush" Color="#FF152033" />
        <SolidColorBrush x:Key="SafeSpeakMutedTextBrush" Color="#FF506078" />
        <SolidColorBrush x:Key="SafeSpeakBorderBrush" Color="#FFC7D0E0" />
        <SolidColorBrush x:Key="SafeSpeakAccentBrush" Color="#FF2459D3" />
        <SolidColorBrush x:Key="SafeSpeakAccentTextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SafeSpeakDangerBrush" Color="#FFB42318" />
        <!-- The palette follows Windows system brushes for High Contrast support. -->
        <Style x:Key="SafeSpeakFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2"
                                   Stroke="{DynamicResource SafeSpeakAccentBrush}"
                                   StrokeThickness="3"
                                   StrokeDashArray="2 1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource SafeSpeakWindowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SafeSpeakSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SafeSpeakAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SafeSpeakAccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakAccentBrush}" />
                                <Setter Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakAccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource SafeSpeakAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakAccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakAccentBrush}" />
        </Style>
        <Style x:Key="EmergencyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakDangerBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource SafeSpeakSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakBorderBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{DynamicResource SafeSpeakSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource SafeSpeakWindowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakBorderBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SafeSpeakSurfaceBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentPresenter ContentSource="Header" Margin="0,0,0,14"
                                                  TextElement.FontSize="17"
                                                  TextElement.FontWeight="Bold" />
                                <ContentPresenter Grid.Row="1" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource SafeSpeakSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SafeSpeakFocusVisual}" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{DynamicResource SafeSpeakMutedTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SafeSpeakSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SafeSpeakBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Application.Resources>
</Application>
