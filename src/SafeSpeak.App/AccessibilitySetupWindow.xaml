<Window x:Class="SafeSpeak.App.AccessibilitySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeSpeak accessibility setup"
        Height="480"
        Width="620"
        MinHeight="450"
        MinWidth="540"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="SafeSpeak accessibility setup">
    <StackPanel Margin="28">
        <TextBlock FontSize="28" FontWeight="Bold" Text="Welcome to SafeSpeak" />
        <TextBlock Margin="0,12,0,18"
                   FontSize="17"
                   TextWrapping="Wrap"
                   Text="Are you fully blind? Choose the option that best matches how you use Windows. SafeSpeak remains keyboard and screen-reader accessible in every mode." />

        <GroupBox Header="Accessibility preference" AutomationProperties.Name="Choose an accessibility preference">
            <StackPanel Margin="12">
                <RadioButton x:Name="FullyBlindOption"
                             Margin="4,8"
                             GroupName="AccessibilityMode"
                             Content="Fully blind — optimize guidance for a screen reader"
                             AutomationProperties.HelpText="Recommended when Windows is primarily operated with NVDA, JAWS, or Narrator." />
                <RadioButton x:Name="PartiallySightedOption"
                             Margin="4,8"
                             GroupName="AccessibilityMode"
                             Content="Partially sighted — use screen-reader guidance and visual status"
                             AutomationProperties.HelpText="Use both spoken guidance and visible information." />
                <RadioButton x:Name="StandardOption"
                             Margin="4,8"
                             GroupName="AccessibilityMode"
                             Content="Standard — use normal accessible controls"
                             AutomationProperties.HelpText="Keep standard accessibility without additional screen-reader guidance." />
            </StackPanel>
        </GroupBox>

        <TextBlock Margin="0,16,0,12"
                   TextWrapping="Wrap"
                   Text="You can change this preference later from the SafeSpeak dashboard. This choice does not change moderation safety settings." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="130"
                    Margin="6"
                    Padding="12,8"
                    Content="Save and continue"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button MinWidth="90"
                    Margin="6"
                    Padding="12,8"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
