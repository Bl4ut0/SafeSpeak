<Window x:Class="SafeSpeak.App.AccessibilitySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeSpeak spoken guidance setup"
        Height="430"
        Width="660"
        MinHeight="400"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="SafeSpeak spoken guidance setup">
    <StackPanel Margin="28">
        <TextBlock FontSize="28"
                   FontWeight="Bold"
                   Text="Welcome to SafeSpeak" />
        <TextBlock Margin="0,14,0,8"
                   FontSize="19"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Text="Would you like SafeSpeak spoken guidance enabled?" />
        <TextBlock Margin="0,0,0,18"
                   TextWrapping="Wrap"
                   Text="Spoken guidance reads SafeSpeak status and safe action results using a local Windows voice. It complements NVDA, JAWS, or Narrator and does not replace them." />

        <StackPanel>
            <Button x:Name="YesButton"
                    MinHeight="54"
                    Margin="0,5"
                    Padding="14,9"
                    HorizontalContentAlignment="Left"
                    Content="_Yes — enable spoken guidance for fully blind operation"
                    IsDefault="True"
                    AutomationProperties.HelpText="Press Enter or Y to enable spoken guidance."
                    Click="YesButton_Click" />
            <Button MinHeight="54"
                    Margin="0,5"
                    Padding="14,9"
                    HorizontalContentAlignment="Left"
                    Content="_No — continue without SafeSpeak spoken guidance"
                    AutomationProperties.HelpText="Press N to continue without SafeSpeak spoken guidance."
                    Click="NoButton_Click" />
            <Button MinHeight="54"
                    Margin="0,5"
                    Padding="14,9"
                    HorizontalContentAlignment="Left"
                    Content="_Partially sighted — enable spoken and visual guidance"
                    AutomationProperties.HelpText="Press P to enable partially sighted mode."
                    Click="PartiallySightedButton_Click" />
        </StackPanel>

        <TextBlock Margin="0,14,0,8"
                   TextWrapping="Wrap"
                   Text="Press Enter or Y for yes, N for no, or P for partially sighted mode. You can change this later from the dashboard." />
        <Button Width="90"
                Margin="0,4,0,0"
                Padding="12,7"
                HorizontalAlignment="Right"
                Content="Cancel"
                IsCancel="True" />
    </StackPanel>
</Window>
