<Window x:Class="SafeSpeak.App.Views.SetupUpdatePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeSpeak &#x2014; Settings &amp; Setup Update"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource SafeSpeakWindowBrush}"
        Foreground="{DynamicResource SafeSpeakTextBrush}"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="SafeSpeak settings update prompt"
        AutomationProperties.HelpText="SafeSpeak settings and setup options have updated. What's new in this version: Streaming platforms: Saved TikTok Direct username is now displayed and announced on Live and Settings. Navigation and speech: Fixed tutorial audio sequencing, tab navigation flow, and relocated chat replies filtering to Settings. Safe and non-destructive: Your existing tokens, models, and custom words are preserved. Press Y to review the setup guide, press N to keep current settings, or press R to repeat the announcement.">

    <Border Margin="20"
            Padding="26,22"
            Background="{DynamicResource SafeSpeakSurfaceBrush}"
            BorderBrush="{DynamicResource SafeSpeakBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <!-- Header Status Badge -->
            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                <Border Style="{StaticResource StatusPill}"
                        Padding="10,3"
                        HorizontalAlignment="Left">
                    <TextBlock Text="Settings &amp; Setup Update"
                               FontWeight="Bold"
                               FontSize="{DynamicResource SafeSpeakFont12}" />
                </Border>
            </DockPanel>

            <!-- Dialog Title -->
            <TextBlock Text="New Settings &amp; Connectors Available"
                       FontSize="{DynamicResource SafeSpeakFont24}"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- Explanatory Prompt Copy -->
            <TextBlock Text="SafeSpeak has updated with new livestream connectors, layout enhancements, and audio settings. Would you like to go through the guided setup again to review your configuration?"
                       FontSize="{DynamicResource SafeSpeakFont15}"
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Summary of Updates Card -->
            <Border Background="{DynamicResource SafeSpeakSurfaceAltBrush}"
                    BorderBrush="{DynamicResource SafeSpeakBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="0,0,0,16"
                    AutomationProperties.Name="What's New in this Version">
                <StackPanel>
                    <TextBlock Text="What's New in this Version:"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource SafeSpeakFont13}"
                               Margin="0,0,0,6" />
                    <ItemsControl x:Name="HighlightsList"
                                  ItemsSource="{Binding HighlightItems, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource SecondaryText}"
                                           FontSize="{DynamicResource SafeSpeakFont12}"
                                           TextWrapping="Wrap"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Keyboard Navigation Advice -->
            <TextBlock Text="Keyboard: Press Y to review the setup guide, N to decline and continue, or R to repeat the announcement. You can also rerun setup anytime from Chapter 8 of Settings (Alt + 8)."
                       Style="{StaticResource SecondaryText}"
                       FontSize="{DynamicResource SafeSpeakFont12}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <!-- Action Buttons Row -->
            <DockPanel LastChildFill="False">
                <Button x:Name="YesButton"
                        DockPanel.Dock="Left"
                        TabIndex="1"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="48"
                        MinWidth="230"
                        Content="Review Setup Guide (Y)"
                        FontWeight="SemiBold"
                        Click="YesButton_Click"
                        AutomationProperties.Name="Review setup guide now (Y)"
                        AutomationProperties.HelpText="Press Y or Enter to launch the guided setup wizard."
                        ToolTip="Press Y or Enter to launch the guided setup wizard." />

                <Button x:Name="DeclineButton"
                        DockPanel.Dock="Left"
                        TabIndex="2"
                        MinHeight="48"
                        MinWidth="210"
                        Margin="14,0,0,0"
                        Content="Keep Current Settings (N)"
                        Click="DeclineButton_Click"
                        AutomationProperties.Name="Keep current settings (N)"
                        AutomationProperties.HelpText="Press N or Escape to keep current configuration and open SafeSpeak."
                        ToolTip="Press N or Escape to keep current configuration and open SafeSpeak." />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
