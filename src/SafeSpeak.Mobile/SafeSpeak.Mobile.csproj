<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SafeSpeakMobileTargetFrameworks Condition="'$(SafeSpeakMobileTargetFrameworks)' == ''">net10.0-android;net10.0-ios</SafeSpeakMobileTargetFrameworks>
    <TargetFrameworks>$(SafeSpeakMobileTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SafeSpeak.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>SafeSpeak Mobile</ApplicationTitle>
    <ApplicationId>com.theprojecthub.safespeak.mobile</ApplicationId>
    <ApplicationDisplayVersion>$(SafeSpeakMobileVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(SafeSpeakMobileBuild)</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="..\..\installer\Assets\SafeSpeakIconMaster-v1.png" Link="Resources/AppIcon/safespeakicon.png" />
    <MauiSplashScreen Include="..\..\installer\Assets\SafeSpeakIconMaster-v1.png" Link="Resources/Splash/safespeaksplash.png" Color="#101426" BaseSize="160,160" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeSpeak.Core\SafeSpeak.Core.csproj" />
  </ItemGroup>

</Project>
